<mxCell id="lgb" value="■ 蓝：改造自 RAVEN 机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="1240" y="98" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="lgo" value="■ 橙 ★：本文新增（核心研究点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1240" y="140" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="lgg" value="■ 绿：升级自 UcON HRM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="1240" y="182" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="todo" value="习惯获取五步（粗→精）&lt;br&gt;① 存储  ② 粗筛  ③ 精判  ④ 聚合  ⑤ 归纳&lt;br&gt;&lt;br&gt;持续更新 TODO&lt;br&gt;- 粗筛 top-k / 阈值选取&lt;br&gt;- 精判检测器选型（开放词表 open-vocab）&lt;br&gt;- 代表帧选取策略（送 VLM 前）&lt;br&gt;- 聚合算法 &amp; conf 计算&lt;br&gt;- 动态维护的强化/衰减函数&lt;br&gt;- acquisition 评测指标 / 新基准&lt;br&gt;- 仿真改造：episode 间物体位置需一致&lt;br&gt;- 时间习惯 time-slot 粒度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1240" y="226" width="220" height="340" as="geometry"/></mxCell>

<!-- ===== 底部说明 ===== -->
<mxCell id="foot" value="一句话：RAVEN 给&quot;怎么把经验变成可检索记忆&quot;（存整帧向量+原图），UcON 给&quot;怎么用习惯找物&quot;（检索利用）；本文新增的习惯获取用&lt;b&gt;粗到精五步&lt;/b&gt;——先 z 场景粗筛圈候选帧，再对候选原图跑检测器精判，跨 episode 聚合成规律，代表帧送 VLM 归纳成结构化习惯元组；配合动态维护构成 感知→获取→维护→利用 闭环。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="40" y="590" width="1160" height="60" as="geometry"/></mxCell>

