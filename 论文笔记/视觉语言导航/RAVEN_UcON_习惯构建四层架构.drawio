<mxCell id="title" value="RAVEN × UcON · 习惯构建架构（感知·存储 → 习惯获取[粗→精五步] → 动态维护 → 检索利用 闭环）　v0.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="40" y="10" width="1420" height="34" as="geometry"/></mxCell>

<!-- ===== Band 1: 观测记忆层（含 ① 存储） ===== -->
<mxCell id="l1" value="观测记忆层 · Observation Memory　（改造 RAVEN：存整帧向量 + 原图，延迟检测）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="58" width="1160" height="30" as="geometry"/></mxCell>
<mxCell id="l1a" value="采集 egocentric RGB 帧&lt;br&gt;（探索 / 日常服务过程中）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="98" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="l1b" value="多模态编码器 → 整帧视觉嵌入 z&lt;br&gt;（场景级语义，不预先抽物体）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="440" y="98" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="l1c" value="①  存储：{ z 整帧向量 · o 原图 · p 位姿 · t 时间 } 入向量库（FAISS / Milvus）&lt;br&gt;&lt;b&gt;关键改动：只存整帧向量 + 原图，检测推迟到精判步&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="820" y="98" width="340" height="64" as="geometry"/></mxCell>

<!-- ===== Band 2: 习惯获取层（②粗筛 ③精判 ④聚合 ⑤归纳，粗→精） ===== -->
<mxCell id="l2" value="习惯获取层 · Habit Acquisition　（★ 新增 — 核心研究点，UcON 缺的 acquisition；粗筛→精判→聚合→归纳，coarse-to-fine）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#b46504;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="192" width="1160" height="30" as="geometry"/></mxCell>
<mxCell id="l2a" value="②  粗筛（场景级）&lt;br&gt;z 场景级检索 → 圈出候选帧&lt;br&gt;（先缩到少量相关帧）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="232" width="265" height="78" as="geometry"/></mxCell>
<mxCell id="l2b" value="③  精判（实例级）&lt;br&gt;候选帧原图 → 检测器 →&lt;br&gt;哪些帧含 o、bbox、共现物体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="345" y="232" width="265" height="78" as="geometry"/></mxCell>
<mxCell id="l2c" value="④  聚合（跨 episode）&lt;br&gt;统计 o 的 (relation, landmark, time)&lt;br&gt;→ 算置信度 conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="630" y="232" width="265" height="78" as="geometry"/></mxCell>
<mxCell id="l2d" value="⑤  归纳&lt;br&gt;代表帧送 VLM →&lt;br&gt;结构化习惯元组 (o, relation, landmark, time, conf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="915" y="232" width="265" height="78" as="geometry"/></mxCell>

<!-- ===== Band 3: 动态维护层（保留） ===== -->
<mxCell id="l3" value="动态维护层 · Dynamic Maintenance　（★ 新增 — 补两篇共同的&quot;静态记忆&quot;局限）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#b46504;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="336" width="1160" height="30" as="geometry"/></mxCell>
<mxCell id="l3a" value="新证据 → 强化&lt;br&gt;（提升 conf）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="60" y="376" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="l3b" value="久未复现 → 衰减&lt;br&gt;（降低 conf）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="440" y="376" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="l3c" value="位置变化 → 触发剪枝 / 改写&lt;br&gt;（应对物体挪位的高动态场景）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="820" y="376" width="360" height="56" as="geometry"/></mxCell>

<!-- ===== Band 4: 检索利用层（保留） ===== -->
<mxCell id="l4" value="检索利用层 · Retrieval &amp; Use　（升级自 UcON HRM）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="458" width="1160" height="30" as="geometry"/></mxCell>
<mxCell id="l4a" value="目标 o → 多工具检索&lt;br&gt;text / position / time（升级单一 BGE-M3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="498" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="l4b" value="每条检索附相似度分数&lt;br&gt;→ LLM 判证据充分 / 部分可观测下迭代搜索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="440" y="498" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="l4c" value="组装 prompt → 基础大模型 plan → 低层动作&lt;br&gt;（MoveAhead / Rotate / Open / Done）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="820" y="498" width="360" height="64" as="geometry"/></mxCell>

