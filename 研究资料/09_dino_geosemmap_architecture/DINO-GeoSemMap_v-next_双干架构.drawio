<mxGraphModel dx="855" dy="649" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DINO-GeoSemMap v-next ：双干 + 联合注意力（构思 v0.1, 2026-06-17）" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="160" y="20" width="600" height="30" as="geometry"/></mxCell><mxCell id="buffer" value="最近 N 帧滚动 buffer（无位姿，纯连续帧）&#10;RGB_{t-N+1 … t}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="330" y="70" width="280" height="50" as="geometry"/></mxCell><mxCell id="semtrunk" value="语义干 Semantic Trunk&#10;DINOv2 ViT (frozen + LoRA)&#10;逐帧 patch 特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="120" y="180" width="260" height="80" as="geometry"/></mxCell><mxCell id="geotrunk" value="几何/时序干 Geo-Temporal Trunk&#10;视频/多视预训练 (VGGT / DUSt3R 族)&#10;帧 buffer 时空特征 + 原生几何" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1"><mxGeometry x="540" y="180" width="280" height="80" as="geometry"/></mxCell><mxCell id="joint" value="联合注意力 Joint Attention（双向 cross-attn）&#10;几何干→语义干：空间/多视一致性先验&#10;语义干→几何干：物体/类别先验&#10;（对称 / 非对称 待 P1 定夺）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="290" y="300" width="360" height="84" as="geometry"/></mxCell><mxCell id="hsem" value="语义头（复用）&#10;Det / Mask / Room&#10;←联合特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="450" width="160" height="80" as="geometry"/></mxCell><mxCell id="hdepth" value="深度头 Depth&#10;米制（几何干精修）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1"><mxGeometry x="240" y="450" width="140" height="80" as="geometry"/></mxCell><mxCell id="hpose" value="位姿头 Rel-Pose（新）&#10;ΔT: SE(3)+6D&#10;深度锚尺度 / 内参鲁棒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="400" y="450" width="180" height="80" as="geometry"/></mxCell><mxCell id="hpred" value="预测头 ×3（新，去动作）&#10;Nowcast 稳化 / Amodal 补全 / 动态外推" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="600" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="yt" value="网络输出 Y_t（现有契约的超集）&#10;+ pose / instance_id / amodal / dynamic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="300" y="600" width="340" height="50" as="geometry"/></mxCell><mxCell id="backend" value="薄几何后端（网络外）&#10;pose-graph + 回环 → 全局一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;" parent="1" vertex="1"><mxGeometry x="300" y="690" width="340" height="50" as="geometry"/></mxCell><mxCell id="downstream" value="下游 GSM / ASM（可吃 DSM 自产位姿）&#10;→ 物体级 3D 语义地图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1"><mxGeometry x="300" y="780" width="340" height="50" as="geometry"/></mxCell><mxCell id="vln" value="VLN / VLA（动作在此 —— 不进 DSM）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="330" y="870" width="280" height="40" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="buffer" target="semtrunk" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" st